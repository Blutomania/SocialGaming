; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Choose Your Mystery"
config/description="AI-powered social murder mystery party game.
Investigate, interrogate, and compete to solve the case first."
config/version="0.1.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/autoloads/GameState.gd"
ApiClient="*res://scripts/autoloads/ApiClient.gd"
NetworkManager="*res://scripts/autoloads/NetworkManager.gd"
Style="*res://scripts/autoloads/Style.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/theme/cym_theme.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.184314, 0.266667, 0.34902, 1)
