# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Corpus and large data files
# NOTE: mystery_database/extractions/ (small JSONs) IS tracked in git
# NOTE: corpus parquet lives in GitHub LFS via user's local push — not tracked here
mystery-crime-books/
*.parquet
*.arrow
*.pkl
*.bin

# Source PDFs staged for ingestion — ~87MB locally and growing, they're the
# *input* to scripts/extract_from_pdfs.py, not its output. The extractions in
# mystery_database/extractions/ are what's worth version-controlling (3.4MB of
# JSON); the books themselves are large, third-party, and re-obtainable.
mystery_database/new_sources/

# Full text pulled out of those PDFs — an intermediate, regenerated by re-running
# extraction. Same reasoning as above.
mystery_database/raw_texts/

# Godot editor import cache (CYM's client at the repo root — the MYF client has
# its own rule in mind-your-friends/.gitignore). Regenerated on open.
# .uid files are deliberately NOT ignored: Godot 4.4+ expects them committed.
godot/.godot/

# HuggingFace / model caches
.cache/
*.safetensors

# Derived from committed *_CRAFT_FINDINGS.md / RESEARCH_FINDINGS.md docs by
# craft_grounding.py — regenerated automatically, never hand-edited. Not
# committed so a stale copy can't survive a checkout (git doesn't preserve
# source mtimes, which the staleness check relies on).
mystery_database/craft_grounding_index.json

# Third-party reference apps (downloaded for UI inspiration only, not our code)
MysterySolver/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Throwaway venv for running real generation in a session (Session 39).
# Never committed: it is ~50MB of installed packages, not source.
.venv-gen/
